# Copy to .env.local (never commit). Values come from your Supabase project settings.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SERVER ONLY. Bypasses row-level security. Never prefix with NEXT_PUBLIC_, never import in client code.
SUPABASE_SERVICE_ROLE_KEY=

# Queue + worker (Day 6)
REDIS_URL=
REDIS_PASSWORD=
WORKER_PORT=8080
WORKER_HOST=127.0.0.1
WORKER_ID=worker-1
LOG_LEVEL=info
