    "lucide-react": "latest",
    "next": "^15",
    "pino": "^10.4.0",
    "react": "^19",
    "react-dom": "^19",
    "server-only": "^0.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "autoprefixer": "latest",
    "esbuild": "^0.28.2",
    "eslint": "^9",
    "eslint-config-next": "^15",
    "postcss": "latest",
    "tailwindcss": "^3",
    "tsx": "^4.23.15",
